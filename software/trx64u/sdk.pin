# The TRX64 SDK that software/trx64u builds against (U18). fetch_sdk.sh checks the tarball against this file and
# unpacks it into software/trx64u/.sdk/ (not in git).
# RELEASE: 0.5.0 (base 3.5), the GitHub release sdk_release of MultiCore's SDK lane in the builds repository (ci/pkg.env MC_BUILDS_REPO), published
# from their branch t239.3, commit 199705ec (their pipeline run 45628574736, T262): the node kind `list`, ctx.ask_list and the node key
# `pick = "@state"`, a tab's `show`, a job node's `busy` (no percentage before the operation reports one), the sources of the F3 search, a key row's
# `legend`, and the base defects P7-P9 (api.md 1.2, README "What is new in 0.5.0"). A library built against 0.4.x loads unchanged.
# fetch_sdk.sh --release takes the tarball there and checks it against the SHA-256 GitHub lists and the release's SHA256SUMS. There is no copy in
# our Gitea registry (U20: Gitea is the archive; a registry upload is Alex's), so the pin names no sdk_package and --download refuses.
# build.sh checks the unpacked VERSION against source_commit and the hashes below. The SDK ships no app image (since 0.4.0): the app is linked
# here from the base archive (pack_cor.sh), and base_archive_sha256 is the hash of its lib/libtrxbase.a as VERSION names it.
sdk_version=0.5.0
sdk_tarball=trx64-sdk-0.5.0.tar.gz
sdk_tarball_sha256=738118b7121fb37e6c1dd14c5e1bccac62c0756835dcd75647b7c2de121632a1
source_branch=t239.3
source_commit=199705ec
base_api=3.5
abi_major=3
api_headers_sha256=5f20315f650767193d099ba57a370eb97aac873c7e1fa67ac9bc550674764e7a
base_archive_sha256=8fa9b73c165ed3aa3442fce3f0102a5b1499159de43b1f60fe09d6a7ec8d1a75
# The online sub-app is not pinned here (U20 D22): apps/online is built by build.sh against this SDK (online_api.h; the base takes the table only
# when it is at least its own OnlineApi's size, netfs.cc online_api). The release's .u2a files (miniz, unzip, testlib) are not taken.
sdk_release=sdk-0.5.0-199705ec
