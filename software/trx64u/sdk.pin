# The TRX64 SDK that software/trx64u builds against (U18). fetch_sdk.sh checks the tarball against this file and
# unpacks it into software/trx64u/.sdk/ (not in git). The SDK comes from TRX64U-MultiCore's branch t239.3 (their D26: we take
# it from there); their builds are in that repository's .ci/sdk/ and in their pipeline's artifacts, which expire.
# A copy of the pinned tarball is in our registry under sdk_package (TREX, generic); fetch_sdk.sh --download takes it there.
# trx64g.cor is packed with this SDK's tools/cor_pack.py too (software/trx64g/pack_large_cor.sh, MultiCore T239.3 D46).
# DEV BUILD: 0.4.5 (base 3.3) from MultiCore's branch t239.3, commit e8b76719, not a release: D11's frame() and still_palette (0.4.3),
# D37's blocks icap and partition with the rule of the board profile and D36's audio_master (0.4.4), and T256's canvas() with the
# grab's column table, no grab when a library's still goes as the menu closes, no Timewarp bar of the base (D12) and the base's still
# freed under a library's (D14). The tarball's name does not carry the commit (trx64-sdk-0.4.5.tar.gz); it unpacks to trx64-sdk-0.4.5/,
# the name a 0.4.5 release unpacks to as well.
# build.sh checks the unpacked VERSION against source_commit and the hashes below, so a release unpacked over it is not
# taken for this build. The SDK ships no app image (since 0.4.0): the app is linked here from the base archive
# (pack_cor.sh), and base_archive_sha256 is the hash of its lib/libtrxbase.a as VERSION names it.
sdk_version=0.4.5
sdk_tarball=trx64-sdk-0.4.5.tar.gz
sdk_package=trx64-sdk/0.4.5-e8b76719
sdk_tarball_sha256=e87e2039f47fd2fff6835e5b532e96f9071ab2c40f5a5dcb4e34f8423e05c920
source_branch=t239.3
source_commit=e8b76719
base_api=3.3
abi_major=3
api_headers_sha256=00b60e800dfb49b8414a945055d04f34e7e64f08232eca53fb8e8bb7cb25483a
base_archive_sha256=1cd49804abf0bb3fcb39a0da6fbd07923e090e80d697d4f55c19f0520fefd372
# The online sub-app (MultiCore T239.3 L-3, D12: online search is a shared sub-app): online.u2a of MultiCore's t239.3 8ff28ba9 apps/online, not inside
# the tarball (their .ci/sdk/ keeps it beside the SDK; 8ff28ba9 is not on their remote, 2b6d6a56b of origin/t239.3 has its subject and the same
# apps/online tree). Rebuilt here byte for byte (2026-11-24) from those sources with 8ff28ba9's coreapp/src/online_api.h (SDK 0.4.2 and later ship it
# as include/online_api.h) and SDK 0.4.1's mk/app.mk; apps/online has not changed since. trx64u.cor carries it in record 7 (pack_cor.sh --lib); it
# registers the operations and states online.* and its menu record brings the F3 tab Online. fetch_sdk.sh checks it against online_u2a_sha256 and puts
# it into .sdk/; a copy goes into our registry under online_package (TREX, generic; fetch_sdk.sh --download).
online_u2a=online.u2a
online_package=trx64-online/1.0-8ff28ba9
online_u2a_sha256=970b0c2ce7586f44a46422fbb6214184cff538f7525ca57718374d560216e32b
online_source_commit=8ff28ba9
