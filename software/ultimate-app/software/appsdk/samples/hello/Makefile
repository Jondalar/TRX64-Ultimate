# Build hello.u2a with a Nios II (U64) and a RISC-V (U64-II, C64U) variant.
#
# Requires nios2-elf-gcc and riscv32-unknown-elf-gcc in $PATH, or run
# build/build_app.sh hello, which runs this Makefile in the build container.
# The rules are in ../../app.mk.

APP       = hello
SDK       = ../..
SRCS      = hello.c

include $(SDK)/app.mk
