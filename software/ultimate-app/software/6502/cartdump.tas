;**************************************************************************
;*
;* FILE  cartdump.tas
;*
;* DESCRIPTION
;*   6502 dumper for Normal 16K cartridges.
;*   Standalone PRG with BASIC SYS stub — run from file browser.
;*
;*   Usage:
;*   1) Firmware creates D64 (mounted on Drive A) + this PRG file.
;*   2) User sets CRT Port to Internal, runs this PRG.
;*   3) On C64 screen: freeze, set CRT Port to External, return.
;*   4) Press any key to dump cart ROM to D64.
;*   5) Run "Dump Cartridge" again to extract CRT.
;*
;*   Load address: $0801 (BASIC start).
;*   Code starts at $0810 via SYS 2064.
;*
;******

        * = $0801

; ---------------------------------------------------------------------------
; BASIC stub: 10 SYS 2064
; ---------------------------------------------------------------------------
        .word basic_end         ; pointer to next BASIC line
        .word 10                ; line number
        .byte $9E               ; SYS token
        .text "2064"            ; $0810 = 2064 decimal
        .byte 0                 ; end of BASIC line
basic_end
        .word 0                 ; end of BASIC program

; Pad to $0810
        .fill $0810 - *, 0

; ---------------------------------------------------------------------------
; Zero-page temporaries
; ---------------------------------------------------------------------------
ZP_PTR1L = $FB
ZP_PTR1H = $FC
ZP_PTR2L = $FD
ZP_PTR2H = $FE

; ---------------------------------------------------------------------------
; Entry point at $0810 (SYS 2064)
; ---------------------------------------------------------------------------
entry
        ; Ensure cart ROMs are visible on C64 CPU bus.
        lda #$2f
        sta $00                 ; DDR
        lda #$37
        sta $01                 ; LORAM=HIRAM=CHAREN=1

        jsr $e544               ; SCINIT — clear screen
        jsr print_title
        jsr print_instr

        ; Wait for any key press
wait_key
        jsr $FFE4               ; GETIN
        beq wait_key

        ; Key pressed — start dump
        jsr print_copy
        jsr copy_rom
        jsr print_save
        jsr save_dump
        bcc dump_ok

        jsr print_error
        jmp halt

dump_ok
        jsr print_ok

halt
        lda #$00
        sta $d020               ; border black
forever
        jmp forever

; ---------------------------------------------------------------------------
; Copy ROML+ROMH ($8000-$BFFF) to RAM ($1000-$4FFF)
; ---------------------------------------------------------------------------
copy_rom
        lda #$00
        sta ZP_PTR1L            ; src lo
        sta ZP_PTR2L            ; dst lo
        lda #$80
        sta ZP_PTR1H            ; src hi = $80
        lda #$10
        sta ZP_PTR2H            ; dst hi = $10
        ldx #$40                ; 64 pages = 16KB

copy_page
        ldy #$00
copy_byte
        lda (ZP_PTR1L),y
        sta (ZP_PTR2L),y
        iny
        bne copy_byte
        inc ZP_PTR1H
        inc ZP_PTR2H
        inc $D020               ; progress flash
        dex
        bne copy_page
        rts

; ---------------------------------------------------------------------------
; KERNAL SAVE: save $1000-$4FFF as "CARTDUMP" to device 8
; Returns carry set on error.
; ---------------------------------------------------------------------------
save_dump
        jsr $FFCC               ; CLRCHN
        jsr $FFE7               ; CLALL

        lda #$01
        ldx #$08
        ldy #$01
        jsr $FFBA               ; SETLFS(1,8,1)

        lda #fname_end - fname
        ldx #<fname
        ldy #>fname
        jsr $FFBD               ; SETNAM

        lda #$00
        sta ZP_PTR1L
        lda #$10
        sta ZP_PTR1H            ; start = $1000

        lda #ZP_PTR1L
        ldx #$00
        ldy #$50                ; end = $5000
        jsr $FFD8               ; SAVE
        php                     ; preserve carry (save result)

        lda #$01
        jsr $FFC3               ; CLOSE(1)
        plp
        rts

; ---------------------------------------------------------------------------
; Text output via CHROUT ($FFD2)
; ---------------------------------------------------------------------------
print_str
        ldy #$00
_ploop
        lda (ZP_PTR1L),y
        beq _pret
        jsr $FFD2
        iny
        bne _ploop
_pret
        rts

print_title
        lda #<msg_title
        sta ZP_PTR1L
        lda #>msg_title
        sta ZP_PTR1H
        jmp print_str

print_instr
        lda #<msg_instr
        sta ZP_PTR1L
        lda #>msg_instr
        sta ZP_PTR1H
        jmp print_str

print_copy
        lda #<msg_copy
        sta ZP_PTR1L
        lda #>msg_copy
        sta ZP_PTR1H
        jmp print_str

print_save
        lda #<msg_save
        sta ZP_PTR1L
        lda #>msg_save
        sta ZP_PTR1H
        jmp print_str

print_ok
        lda #<msg_ok
        sta ZP_PTR1L
        lda #>msg_ok
        sta ZP_PTR1H
        jmp print_str

print_error
        lda #<msg_error
        sta ZP_PTR1L
        lda #>msg_error
        sta ZP_PTR1H
        jmp print_str

; ---------------------------------------------------------------------------
; Data
; ---------------------------------------------------------------------------
fname
        .text "CARTDUMP"
fname_end

msg_title
        .text "TREX U64 CRT HELPER"
        .byte 13,13,0

msg_instr
        .text "1) FREEZE, SET CRT PORT"
        .byte 13
        .text "   TO EXTERNAL"
        .byte 13
        .text "2) RETURN TO C64"
        .byte 13
        .text "3) PRESS ANY KEY TO DUMP"
        .byte 13,13,0

msg_copy
        .text "COPYING $8000-$BFFF TO RAM..."
        .byte 13,0

msg_save
        .text "SAVING CARTDUMP TO DEVICE 8..."
        .byte 13,0

msg_ok
        .text "DONE! FREEZE AND RUN"
        .byte 13
        .text "'DUMP CARTRIDGE' TO"
        .byte 13
        .text "EXTRACT THE CRT."
        .byte 13,0

msg_error
        .text "SAVE ERROR!"
        .byte 13,0
