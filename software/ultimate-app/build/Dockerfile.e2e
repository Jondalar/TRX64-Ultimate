# u64-e2e-env: the CI build image plus ue2emu, so a job can build the firmware
# and the apps and then run the emulator suites against them in one place.
#
# Built on the NAS next to u64-build-env:ci and kept in its Docker, like that
# one (no registry):
#
#   docker build -t u64-e2e-env:ci - < Dockerfile.e2e
#
# The build context is empty: everything comes from the base image, apt and
# GitHub. ue2emu is built from its release tag with cargo, which is also what
# the Homebrew formula does on Linux (github.com/Jondalar/homebrew-ue2emu).
# Its default features need libslirp 4.7+ (--net user, which the REST suites use)
# and a C++ compiler for TRX64's reSID; ALSA is linked even when --headless.

FROM u64-build-env:ci

RUN apt-get update \
 && apt-get install -y --no-install-recommends libasound2-dev pkg-config \
        libglib2.0-dev meson ninja-build \
 && rm -rf /var/lib/apt/lists/*

# Ubuntu 22.04 ships libslirp 4.6.1, which lacks slirp_handle_timer (4.7+);
# ue2-net calls it, so the link fails with the distribution package.
ARG LIBSLIRP_TAG=v4.8.0
RUN git clone --depth 1 --branch ${LIBSLIRP_TAG} https://gitlab.freedesktop.org/slirp/libslirp.git /tmp/libslirp \
 && cd /tmp/libslirp \
 && meson setup build --prefix=/usr/local --libdir=lib \
 && ninja -C build install \
 && ldconfig \
 && rm -rf /tmp/libslirp

ENV RUSTUP_HOME=/opt/rust \
    CARGO_HOME=/opt/cargo \
    PATH=/opt/cargo/bin:$PATH \
    # cargo's own git client does not see the HTTP/1.1 setting the base image
    # needs on this NAS; the git command line does.
    CARGO_NET_GIT_FETCH_WITH_CLI=true \
    # crates/ue2-net/build.rs links libslirp from here, as the Homebrew formula does.
    SLIRP_LIB_DIR=/usr/local/lib \
    PKG_CONFIG_PATH=/usr/local/lib/pkgconfig

RUN curl -sSf https://sh.rustup.rs | sh -s -- -y --profile minimal --default-toolchain stable

# 0.6.0 brought the TRX IO block (S37, --trx-io), which the trx-service-boot
# suite needs; 0.5.x does not know the flag and that suite then skips.
# The image is not rebuilt by CI: after a bump, build it on the NAS.
ARG UE2EMU_TAG=v0.6.0
RUN cargo install --locked --root /opt/ue2emu \
        --git https://github.com/Jondalar/UE2-C64U-Emulator --tag ${UE2EMU_TAG} ue2emu \
 && rm -rf /opt/cargo/registry /opt/cargo/git \
 && /opt/ue2emu/bin/ue2emu --version

# tests/e2e/lib/emulator.py looks here first.
ENV U64_EMU=/opt/ue2emu/bin/ue2emu
