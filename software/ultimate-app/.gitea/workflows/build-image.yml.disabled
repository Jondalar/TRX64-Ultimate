#         run: |
#           set -eu
#           test -f "${CONTEXT}/quartus-18.1.tar.gz"
#
#       - name: Fetch the Dockerfile from this commit
#         env:
#           TOKEN: ${{ secrets.GITEA_TOKEN || secrets.GITHUB_TOKEN }}
#         run: |
#           set -eu
#           apk add --no-cache git >/dev/null
#           SERVER="${GITHUB_SERVER_URL#*://}"
#           git clone --depth 1 --branch "${GITHUB_REF_NAME}" \
#             "http://actions:${TOKEN}@${SERVER}/${GITHUB_REPOSITORY}.git" src
#           cp src/build/Dockerfile.ci "${CONTEXT}/Dockerfile.ci"
#
#       - name: Build
#         run: |
#           set -eu
#           docker build -f "${CONTEXT}/Dockerfile.ci" \
#             -t "${IMAGE}" -t u64-build-env:latest "${CONTEXT}"
#
# act_runner 0.6.1 panics in its reporter past roughly 45 minutes: the image
# would be built and usable while the job still shows red.
